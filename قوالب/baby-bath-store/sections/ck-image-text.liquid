{%- liquid
  assign hf = section.settings.heading_font
  assign bf = section.settings.body_font
-%}
<style>
  #shopify-section-{{ section.id }} {
    --ck-heading-font: {{ hf.family }}, {{ hf.fallback_families }};
    --ck-body-font: {{ bf.family }}, {{ bf.fallback_families }};
  }
  {{ hf | font_face: font_display: 'swap' }}
  {{ bf | font_face: font_display: 'swap' }}
</style>
<div class="color-{{ section.settings.color_scheme }} ck-scheme">
<div class="ck-image-text" style="
    --ck-bg: {{ section.settings.background_color }};
    --ck-fg: {{ section.settings.text_color }};
    --ck-heading-color: {{ section.settings.heading_color }};
    --ck-btn-bg: {{ section.settings.button_background }};
    --ck-btn-fg: {{ section.settings.button_text }};
    --ck-btn-bg-hover: {{ section.settings.button_hover_background }};
    --ck-btn-border: {{ section.settings.button_border }};
    --ck-btn-border-w: {{ section.settings.button_border_width }}px;
    --ck-h-size: {{ section.settings.heading_size }}px;
    --ck-h-size-m: {{ section.settings.heading_size_mobile }}px;
    --ck-h-weight: {{ section.settings.heading_weight }};
    --ck-h-lh: {{ section.settings.heading_line_height }};
    --ck-h-ls: {{ section.settings.heading_letter_spacing }}em;
    --ck-h-tt: {{ section.settings.heading_text_transform }};
    --ck-b-size: {{ section.settings.body_size }}px;
    --ck-b-size-m: {{ section.settings.body_size_mobile }}px;
    --ck-b-lh: {{ section.settings.body_line_height }};
    --ck-btn-size: {{ section.settings.button_size }}px;
    --ck-btn-weight: {{ section.settings.button_weight }};
    --ck-btn-tt: {{ section.settings.button_text_transform }};
    --ck-btn-ls: {{ section.settings.button_letter_spacing }}em;
    --ck-pad-top: {{ section.settings.padding_top }}px;
    --ck-pad-bottom: {{ section.settings.padding_bottom }}px;
    --ck-pad-top-m: {{ section.settings.padding_top_mobile }}px;
    --ck-pad-bottom-m: {{ section.settings.padding_bottom_mobile }}px;
    --ck-max-width: {{ section.settings.content_width }}px;
    --ck-gutter: {{ section.settings.side_padding }}px;
    --ck-align: {{ section.settings.text_alignment }};
    --ck-radius: {{ section.settings.corner_radius }}px;
    --ck-btn-px: {{ section.settings.button_padding_x }}px;
    --ck-btn-py: {{ section.settings.button_padding_y }}px;
    --ck-anim-dur: {{ section.settings.animation_duration }}ms;
    --ck-anim-distance: {{ section.settings.animation_distance }}px;
    --ck-media-w: {{ section.settings.media_width }}%;
    --ck-min-h: {{ section.settings.min_height_desktop }}px;
    --ck-min-h-m: {{ section.settings.min_height_mobile }}px;
    --ck-box-w: {{ section.settings.text_box_width }}px;
    --ck-text-gap: {{ section.settings.text_gap }}px;
    --ck-content-bg: {{ section.settings.content_background }};
    --ck-valign: {{ section.settings.vertical_alignment }};
    --ck-fit: {{ section.settings.image_fit }};
  " data-animate="{{ section.settings.animation_style }}"
  {%- if section.settings.full_width %} data-full-width{% endif %}
  {%- unless section.settings.show_on_mobile %} data-hide-mobile{% endunless %}
  {%- unless section.settings.show_on_desktop %} data-hide-desktop{% endunless %}
>
<div class="ck-it__grid" data-media="{{ section.settings.media_position }}">
  <div class="ck-it__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: widths: '375, 550, 750, 1100, 1500', sizes: '(min-width: 750px) 50vw, 100vw', class: 'ck-it__img', loading: lazy }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'ck-it__img ck-it__ph' }}
    {%- endif -%}
  </div>
  <div class="ck-it__content">
    <div class="ck-it__box">
      {%- if section.settings.heading != blank -%}<h2 class="ck-heading">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="ck-text ck-it__text">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}<a class="ck-btn ck-it__btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>{%- endif -%}
    </div>
  </div>
</div>
</div>
</div>

{% stylesheet %}
.ck-image-text { background: var(--ck-bg); color: var(--ck-fg); font-family: var(--ck-body-font); font-size: var(--ck-b-size-m); line-height: var(--ck-b-lh); padding-top: var(--ck-pad-top-m); padding-bottom: var(--ck-pad-bottom-m); text-align: var(--ck-align); }
.ck-image-text .ck-inner { max-width: var(--ck-max-width); margin: 0 auto; padding-left: var(--ck-gutter); padding-right: var(--ck-gutter); }
.ck-image-text[data-full-width] .ck-inner { max-width: 100%; }
.ck-image-text .ck-heading { font-family: var(--ck-heading-font); font-size: var(--ck-h-size-m); font-weight: var(--ck-h-weight); line-height: var(--ck-h-lh); letter-spacing: var(--ck-h-ls); text-transform: var(--ck-h-tt); color: var(--ck-heading-color); margin: 0; }
.ck-image-text .ck-text p { margin: 0; }
.ck-image-text .ck-btn { display: inline-block; background: var(--ck-btn-bg); color: var(--ck-btn-fg); border: var(--ck-btn-border-w) solid var(--ck-btn-border); border-radius: var(--ck-radius); padding: var(--ck-btn-py) var(--ck-btn-px); font-family: var(--ck-body-font); font-size: var(--ck-btn-size); font-weight: var(--ck-btn-weight); text-transform: var(--ck-btn-tt); letter-spacing: var(--ck-btn-ls); line-height: 1.2; text-decoration: none; cursor: pointer; transition: background-color var(--ck-anim-dur) ease; }
.ck-image-text .ck-btn:hover { background: var(--ck-btn-bg-hover); }
.ck-image-text[data-animate="fade"] .ck-inner { animation: ck-fade var(--ck-anim-dur) ease both; }
.ck-image-text[data-animate="slide"] .ck-inner { animation: ck-slide var(--ck-anim-dur) ease both; }
@keyframes ck-fade { from { opacity: 0; } to { opacity: 1; } }
@keyframes ck-slide { from { opacity: 0; transform: translateY(var(--ck-anim-distance)); } to { opacity: 1; transform: none; } }
@media screen and (max-width: 749px) { .ck-image-text[data-hide-mobile] { display: none; } }
@media screen and (min-width: 750px) {
  .ck-image-text { font-size: var(--ck-b-size); padding-top: var(--ck-pad-top); padding-bottom: var(--ck-pad-bottom); }
  .ck-image-text .ck-heading { font-size: var(--ck-h-size); }
  .ck-image-text[data-hide-desktop] { display: none; }
}
/* reduced motion must beat every animation rule above, including Dawn's */
@media (prefers-reduced-motion: reduce) { .ck-image-text * { animation: none !important; transition: none !important; } }

.ck-image-text .ck-it__grid { display: flex; flex-direction: column; }
.ck-image-text .ck-it__media { position: relative; height: var(--ck-min-h-m); overflow: hidden; }
.ck-image-text .ck-it__img { width: 100%; height: 100%; object-fit: var(--ck-fit); display: block; }
.ck-image-text .ck-it__content { background: var(--ck-content-bg); display: flex; align-items: var(--ck-valign); justify-content: center; padding: var(--ck-pad-top-m) var(--ck-gutter) var(--ck-pad-bottom-m); }
.ck-image-text .ck-it__box { max-width: var(--ck-box-w); }
.ck-image-text .ck-it__text, .ck-image-text .ck-it__btn { margin-top: var(--ck-text-gap); }
@media screen and (min-width: 750px) {
  .ck-image-text .ck-it__grid { flex-direction: row; min-height: var(--ck-min-h); }
  .ck-image-text .ck-it__grid[data-media="right"] { flex-direction: row-reverse; }
  .ck-image-text .ck-it__media { flex: 0 0 var(--ck-media-w); height: auto; }
  .ck-image-text .ck-it__content { flex: 1; padding: var(--ck-pad-top) var(--ck-gutter) var(--ck-pad-bottom); }
}
{% endstylesheet %}

{% javascript %}
document.addEventListener('shopify:section:load', () => {});
document.addEventListener('shopify:section:unload', () => {});
{% endjavascript %}

{% schema %}
{
  "name": "Clone: image with text",
  "tag": "section",
  "class": "ck-section",
  "settings": [
    {
      "type": "header",
      "content": "Image with text"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "default": "cover",
      "options": [
        {
          "value": "cover",
          "label": "Fill"
        },
        {
          "value": "contain",
          "label": "Fit"
