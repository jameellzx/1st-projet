{%- liquid
  assign hf = section.settings.heading_font
  assign bf = section.settings.body_font
-%}
<style>
  #shopify-section-{{ section.id }} {
    --ck-heading-font: {{ hf.family }}, {{ hf.fallback_families }};
    --ck-body-font: {{ bf.family }}, {{ bf.fallback_families }};
  }
  {{ hf | font_face: font_display: 'swap' }}
  {{ bf | font_face: font_display: 'swap' }}
</style>
<div class="color-{{ section.settings.color_scheme }} ck-scheme">
<div class="ck-footer" style="
    --ck-bg: {{ section.settings.background_color }};
    --ck-fg: {{ section.settings.text_color }};
    --ck-heading-color: {{ section.settings.heading_color }};
    --ck-btn-bg: {{ section.settings.button_background }};
    --ck-btn-fg: {{ section.settings.button_text }};
    --ck-btn-bg-hover: {{ section.settings.button_hover_background }};
    --ck-btn-border: {{ section.settings.button_border }};
    --ck-btn-border-w: {{ section.settings.button_border_width }}px;
    --ck-h-size: {{ section.settings.heading_size }}px;
    --ck-h-size-m: {{ section.settings.heading_size_mobile }}px;
    --ck-h-weight: {{ section.settings.heading_weight }};
    --ck-h-lh: {{ section.settings.heading_line_height }};
    --ck-h-ls: {{ section.settings.heading_letter_spacing }}em;
    --ck-h-tt: {{ section.settings.heading_text_transform }};
    --ck-b-size: {{ section.settings.body_size }}px;
    --ck-b-size-m: {{ section.settings.body_size_mobile }}px;
    --ck-b-lh: {{ section.settings.body_line_height }};
    --ck-btn-size: {{ section.settings.button_size }}px;
    --ck-btn-weight: {{ section.settings.button_weight }};
    --ck-btn-tt: {{ section.settings.button_text_transform }};
    --ck-btn-ls: {{ section.settings.button_letter_spacing }}em;
    --ck-pad-top: {{ section.settings.padding_top }}px;
    --ck-pad-bottom: {{ section.settings.padding_bottom }}px;
    --ck-pad-top-m: {{ section.settings.padding_top_mobile }}px;
    --ck-pad-bottom-m: {{ section.settings.padding_bottom_mobile }}px;
    --ck-max-width: {{ section.settings.content_width }}px;
    --ck-gutter: {{ section.settings.side_padding }}px;
    --ck-align: {{ section.settings.text_alignment }};
    --ck-radius: {{ section.settings.corner_radius }}px;
    --ck-btn-px: {{ section.settings.button_padding_x }}px;
    --ck-btn-py: {{ section.settings.button_padding_y }}px;
    --ck-anim-dur: {{ section.settings.animation_duration }}ms;
    --ck-anim-distance: {{ section.settings.animation_distance }}px;
    --ck-cols: {{ section.settings.columns_desktop }};
    --ck-cols-tablet: {{ section.settings.columns_tablet }};
    --ck-cols-mobile: {{ section.settings.columns_mobile }};
    --ck-gap: {{ section.settings.gap }}px;
    --ck-logo-w: {{ section.settings.logo_width }}px;
    --ck-title-size: {{ section.settings.title_size }}px;
    --ck-link-size: {{ section.settings.link_size }}px;
    --ck-link-gap: {{ section.settings.link_gap }}px;
    --ck-line: {{ section.settings.line_color }};
    --ck-small-size: {{ section.settings.small_size }}px;
  " data-animate="{{ section.settings.animation_style }}"
  {%- if section.settings.full_width %} data-full-width{% endif %}
  {%- unless section.settings.show_on_mobile %} data-hide-mobile{% endunless %}
  {%- unless section.settings.show_on_desktop %} data-hide-desktop{% endunless %}
>
<div class="ck-inner ck-ft__top">
  <div class="ck-ft__brand">
    <a href="{{ routes.root_url }}" class="ck-ft__logo">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 2400 | image_tag: widths: '100, 200, 300', sizes: '120px', class: 'ck-ft__logo-img', loading: lazy }}
      {%- else -%}
        <span class="ck-heading">{{ shop.name | escape }}</span>
      {%- endif -%}
    </a>
  </div>
  {%- for block in section.blocks -%}
    <nav class="ck-ft__col" {{ block.shopify_attributes }}>
      {%- if block.settings.title != blank -%}<p class="ck-ft__title">{{ block.settings.title | escape }}</p>{%- endif -%}
      {%- if block.settings.menu != blank -%}
        <ul class="ck-ft__links" role="list">
          {%- for link in block.settings.menu.links -%}
            <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </nav>
  {%- endfor -%}
  {%- if section.settings.show_newsletter -%}
    <div class="ck-ft__news">
      {%- if section.settings.newsletter_heading != blank -%}<p class="ck-ft__title">{{ section.settings.newsletter_heading | escape }}</p>{%- endif -%}
      {%- form 'customer', class: 'ck-ft__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input class="ck-ft__input" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ section.settings.email_placeholder | escape }}" aria-label="{{ section.settings.email_placeholder | escape }}">
        <button type="submit" class="ck-ft__submit" aria-label="{{ section.settings.submit_label | escape }}"><svg viewBox="0 0 24 24" width="100%" height="100%" aria-hidden="true" focusable="false"><path d="m9 4 8 8-8 8" fill="none" stroke="currentColor" stroke-width="2"/></svg></button>
        {%- if form.posted_successfully? -%}<p class="ck-ft__ok">{{ section.settings.success_message | escape }}</p>{%- endif -%}
      {%- endform -%}
      {%- if section.settings.newsletter_note != blank -%}<div class="ck-ft__note">{{ section.settings.newsletter_note }}</div>{%- endif -%}
      {%- if section.settings.show_social -%}{% render 'social-icons', class: 'ck-ft__social' %}{%- endif -%}
    </div>
  {%- endif -%}
</div>
<div class="ck-inner ck-ft__bottom">
  <span>{{ section.settings.copyright_prefix | escape }} {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</span>
  {%- if section.settings.show_policies -%}
    {%- for policy in shop.policies -%}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{%- endfor -%}
  {%- endif -%}
</div>
</div>
</div>

{% stylesheet %}
.ck-footer { background: var(--ck-bg); color: var(--ck-fg); font-family: var(--ck-body-font); font-size: var(--ck-b-size-m); line-height: var(--ck-b-lh); padding-top: var(--ck-pad-top-m); padding-bottom: var(--ck-pad-bottom-m); text-align: var(--ck-align); }
.ck-footer .ck-inner { max-width: var(--ck-max-width); margin: 0 auto; padding-left: var(--ck-gutter); padding-right: var(--ck-gutter); }
.ck-footer[data-full-width] .ck-inner { max-width: 100%; }
.ck-footer .ck-heading { font-family: var(--ck-heading-font); font-size: var(--ck-h-size-m); font-weight: var(--ck-h-weight); line-height: var(--ck-h-lh); letter-spacing: var(--ck-h-ls); text-transform: var(--ck-h-tt); color: var(--ck-heading-color); margin: 0; }
.ck-footer .ck-text p { margin: 0; }
.ck-footer .ck-btn { display: inline-block; background: var(--ck-btn-bg); color: var(--ck-btn-fg); border: var(--ck-btn-border-w) solid var(--ck-btn-border); border-radius: var(--ck-radius); padding: var(--ck-btn-py) var(--ck-btn-px); font-family: var(--ck-body-font); font-size: var(--ck-btn-size); font-weight: var(--ck-btn-weight); text-transform: var(--ck-btn-tt); letter-spacing: var(--ck-btn-ls); line-height: 1.2; text-decoration: none; cursor: pointer; transition: background-color var(--ck-anim-dur) ease; }
.ck-footer .ck-btn:hover { background: var(--ck-btn-bg-hover); }
.ck-footer[data-animate="fade"] .ck-inner { animation: ck-fade var(--ck-anim-dur) ease both; }
.ck-footer[data-animate="slide"] .ck-inner { animation: ck-slide var(--ck-anim-dur) ease both; }
@keyframes ck-fade { from { opacity: 0; } to { opacity: 1; } }
@keyframes ck-slide { from { opacity: 0; transform: translateY(var(--ck-anim-distance)); } to { opacity: 1; transform: none; } }
@media screen and (max-width: 749px) { .ck-footer[data-hide-mobile] { display: none; } }
@media screen and (min-width: 750px) {
  .ck-footer { font-size: var(--ck-b-size); padding-top: var(--ck-pad-top); padding-bottom: var(--ck-pad-bottom); }
  .ck-footer .ck-heading { font-size: var(--ck-h-size); }
  .ck-footer[data-hide-desktop] { display: none; }
}
/* reduced motion must beat every animation rule above, including Dawn's */
@media (prefers-reduced-motion: reduce) { .ck-footer * { animation: none !important; transition: none !important; } }

.ck-footer { text-align: left; }
.ck-footer .ck-ft__top { display: grid; gap: var(--ck-gap); grid-template-columns: repeat(var(--ck-cols-mobile), minmax(0, 1fr)); }
.ck-footer .ck-ft__brand, .ck-footer .ck-ft__news { grid-column: 1 / -1; }
.ck-footer .ck-ft__logo { display: inline-block; color: inherit; text-decoration: none; }
.ck-footer .ck-ft__logo-img { width: var(--ck-logo-w); height: auto; display: block; }
.ck-footer .ck-ft__title { margin: 0 0 var(--ck-link-gap); font-size: var(--ck-title-size); font-weight: var(--ck-h-weight); }
.ck-footer .ck-ft__links { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--ck-link-gap); }
.ck-footer .ck-ft__links a, .ck-footer .ck-ft__bottom a { color: inherit; text-decoration: none; font-size: var(--ck-link-size); }
.ck-footer .ck-ft__links a:hover, .ck-footer .ck-ft__bottom a:hover { text-decoration: underline; }
.ck-footer .ck-ft__form { display: flex; align-items: center; border-bottom: 1px solid var(--ck-line); }
.ck-footer .ck-ft__input { flex: 1; border: 0; background: transparent; color: inherit; font: inherit; font-size: var(--ck-link-size); padding: var(--ck-link-gap) 0; outline-offset: 2px; }
.ck-footer .ck-ft__submit { width: var(--ck-title-size); height: var(--ck-title-size); border: 0; padding: 0; background: none; color: inherit; cursor: pointer; }
.ck-footer .ck-ft__ok, .ck-footer .ck-ft__note { font-size: var(--ck-small-size); margin-top: var(--ck-link-gap); }
.ck-footer .ck-ft__social { margin-top: var(--ck-link-gap); justify-content: flex-start; }
.ck-footer .ck-ft__bottom { display: flex; flex-wrap: wrap; gap: var(--ck-link-gap) var(--ck-gap); margin-top: var(--ck-gap); font-size: var(--ck-small-size); }
.ck-footer .ck-ft__bottom a { font-size: var(--ck-small-size); }
@media screen and (min-width: 750px) {
  .ck-footer .ck-ft__top { grid-template-columns: repeat(var(--ck-cols-tablet), minmax(0, 1fr)); }
}
@media screen and (min-width: 990px) {
  .ck-footer .ck-ft__top { grid-template-columns: repeat(var(--ck-cols), minmax(0, 1fr)); }
  .ck-footer .ck-ft__brand { grid-column: auto; }
  .ck-footer .ck-ft__news { grid-column: span 2; }
}
{% endstylesheet %}

{% javascript %}
document.addEventListener('shopify:section:load', () => {});
document.addEventListener('shopify:section:unload', () => {});
{% endjavascript %}

