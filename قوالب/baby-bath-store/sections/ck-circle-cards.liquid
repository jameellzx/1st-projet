{%- liquid
  assign hf = section.settings.heading_font
  assign bf = section.settings.body_font
-%}
<style>
  #shopify-section-{{ section.id }} {
    --ck-heading-font: {{ hf.family }}, {{ hf.fallback_families }};
    --ck-body-font: {{ bf.family }}, {{ bf.fallback_families }};
  }
  {{ hf | font_face: font_display: 'swap' }}
  {{ bf | font_face: font_display: 'swap' }}
</style>
<div class="color-{{ section.settings.color_scheme }} ck-scheme">
<div class="ck-circle-cards" style="
    --ck-bg: {{ section.settings.background_color }};
    --ck-fg: {{ section.settings.text_color }};
    --ck-heading-color: {{ section.settings.heading_color }};
    --ck-btn-bg: {{ section.settings.button_background }};
    --ck-btn-fg: {{ section.settings.button_text }};
    --ck-btn-bg-hover: {{ section.settings.button_hover_background }};
    --ck-btn-border: {{ section.settings.button_border }};
    --ck-btn-border-w: {{ section.settings.button_border_width }}px;
    --ck-h-size: {{ section.settings.heading_size }}px;
    --ck-h-size-m: {{ section.settings.heading_size_mobile }}px;
    --ck-h-weight: {{ section.settings.heading_weight }};
    --ck-h-lh: {{ section.settings.heading_line_height }};
    --ck-h-ls: {{ section.settings.heading_letter_spacing }}em;
    --ck-h-tt: {{ section.settings.heading_text_transform }};
    --ck-b-size: {{ section.settings.body_size }}px;
    --ck-b-size-m: {{ section.settings.body_size_mobile }}px;
    --ck-b-lh: {{ section.settings.body_line_height }};
    --ck-btn-size: {{ section.settings.button_size }}px;
    --ck-btn-weight: {{ section.settings.button_weight }};
    --ck-btn-tt: {{ section.settings.button_text_transform }};
    --ck-btn-ls: {{ section.settings.button_letter_spacing }}em;
    --ck-pad-top: {{ section.settings.padding_top }}px;
    --ck-pad-bottom: {{ section.settings.padding_bottom }}px;
    --ck-pad-top-m: {{ section.settings.padding_top_mobile }}px;
    --ck-pad-bottom-m: {{ section.settings.padding_bottom_mobile }}px;
    --ck-max-width: {{ section.settings.content_width }}px;
    --ck-gutter: {{ section.settings.side_padding }}px;
    --ck-align: {{ section.settings.text_alignment }};
    --ck-radius: {{ section.settings.corner_radius }}px;
    --ck-btn-px: {{ section.settings.button_padding_x }}px;
    --ck-btn-py: {{ section.settings.button_padding_y }}px;
    --ck-anim-dur: {{ section.settings.animation_duration }}ms;
    --ck-anim-distance: {{ section.settings.animation_distance }}px;
    --ck-cols: {{ section.settings.columns_desktop }};
    --ck-cols-tablet: {{ section.settings.columns_tablet }};
    --ck-cols-mobile: {{ section.settings.columns_mobile }};
    --ck-gap: {{ section.settings.gap }}px;
    --ck-img-size: {{ section.settings.image_size }}%;
    --ck-label-size: {{ section.settings.label_size }}px;
    --ck-label-color: {{ section.settings.label_color }};
    --ck-heading-gap: {{ section.settings.heading_gap }}px;
    --ck-hover-scale: {{ section.settings.hover_zoom | divided_by: 100.0 | plus: 1 }};
  " data-animate="{{ section.settings.animation_style }}"
  {%- if section.settings.full_width %} data-full-width{% endif %}
  {%- unless section.settings.show_on_mobile %} data-hide-mobile{% endunless %}
  {%- unless section.settings.show_on_desktop %} data-hide-desktop{% endunless %}
>
<div class="ck-inner">
  {%- if section.settings.heading != blank -%}<h2 class="ck-heading ck-cards__heading">{{ section.settings.heading }}</h2>{%- endif -%}
  <div class="ck-cards__grid">
    {%- for block in section.blocks -%}
      <a class="ck-cards__card" href="{{ block.settings.link | default: routes.all_products_collection_url }}" style="{% if block.settings.ring_color != blank %}--ck-ring: {{ block.settings.ring_color }};{% endif %}" {{ block.shopify_attributes }}>
        <span class="ck-cards__media">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 2400 | image_tag: widths: '275, 400, 550, 800', sizes: '(min-width: 990px) 25vw, 50vw', class: 'ck-cards__img', loading: lazy }}
          {%- else -%}
            {%- assign ph_n = forloop.index0 | modulo: 6 | plus: 1 -%}
            {%- assign ph = 'collection-' | append: ph_n -%}
            {{ ph | placeholder_svg_tag: 'ck-cards__img' }}
          {%- endif -%}
        </span>
        <span class="ck-cards__label">{{ block.settings.label | escape }}</span>
      </a>
    {%- endfor -%}
  </div>
</div>
</div>
</div>

{% stylesheet %}
.ck-circle-cards { background: var(--ck-bg); color: var(--ck-fg); font-family: var(--ck-body-font); font-size: var(--ck-b-size-m); line-height: var(--ck-b-lh); padding-top: var(--ck-pad-top-m); padding-bottom: var(--ck-pad-bottom-m); text-align: var(--ck-align); }
.ck-circle-cards .ck-inner { max-width: var(--ck-max-width); margin: 0 auto; padding-left: var(--ck-gutter); padding-right: var(--ck-gutter); }
.ck-circle-cards[data-full-width] .ck-inner { max-width: 100%; }
.ck-circle-cards .ck-heading { font-family: var(--ck-heading-font); font-size: var(--ck-h-size-m); font-weight: var(--ck-h-weight); line-height: var(--ck-h-lh); letter-spacing: var(--ck-h-ls); text-transform: var(--ck-h-tt); color: var(--ck-heading-color); margin: 0; }
.ck-circle-cards .ck-text p { margin: 0; }
.ck-circle-cards .ck-btn { display: inline-block; background: var(--ck-btn-bg); color: var(--ck-btn-fg); border: var(--ck-btn-border-w) solid var(--ck-btn-border); border-radius: var(--ck-radius); padding: var(--ck-btn-py) var(--ck-btn-px); font-family: var(--ck-body-font); font-size: var(--ck-btn-size); font-weight: var(--ck-btn-weight); text-transform: var(--ck-btn-tt); letter-spacing: var(--ck-btn-ls); line-height: 1.2; text-decoration: none; cursor: pointer; transition: background-color var(--ck-anim-dur) ease; }
.ck-circle-cards .ck-btn:hover { background: var(--ck-btn-bg-hover); }
.ck-circle-cards[data-animate="fade"] .ck-inner { animation: ck-fade var(--ck-anim-dur) ease both; }
.ck-circle-cards[data-animate="slide"] .ck-inner { animation: ck-slide var(--ck-anim-dur) ease both; }
@keyframes ck-fade { from { opacity: 0; } to { opacity: 1; } }
@keyframes ck-slide { from { opacity: 0; transform: translateY(var(--ck-anim-distance)); } to { opacity: 1; transform: none; } }
@media screen and (max-width: 749px) { .ck-circle-cards[data-hide-mobile] { display: none; } }
@media screen and (min-width: 750px) {
  .ck-circle-cards { font-size: var(--ck-b-size); padding-top: var(--ck-pad-top); padding-bottom: var(--ck-pad-bottom); }
  .ck-circle-cards .ck-heading { font-size: var(--ck-h-size); }
  .ck-circle-cards[data-hide-desktop] { display: none; }
}
/* reduced motion must beat every animation rule above, including Dawn's */
@media (prefers-reduced-motion: reduce) { .ck-circle-cards * { animation: none !important; transition: none !important; } }

.ck-circle-cards .ck-cards__heading { margin-bottom: var(--ck-heading-gap); }
.ck-circle-cards .ck-cards__grid { display: grid; gap: var(--ck-gap); grid-template-columns: repeat(var(--ck-cols-mobile), minmax(0, 1fr)); }
.ck-circle-cards .ck-cards__card { display: flex; flex-direction: column; align-items: center; gap: var(--ck-gap); text-decoration: none; color: var(--ck-label-color); }
.ck-circle-cards .ck-cards__media { display: block; width: var(--ck-img-size); aspect-ratio: 1; border-radius: 50%; overflow: hidden; background: var(--ck-ring, transparent); transition: transform var(--ck-anim-dur) ease; }
.ck-circle-cards .ck-cards__card:hover .ck-cards__media { transform: scale(var(--ck-hover-scale)); }
.ck-circle-cards .ck-cards__img { width: 100%; height: 100%; object-fit: cover; display: block; }
.ck-circle-cards .ck-cards__label { font-size: var(--ck-label-size); }
@media screen and (min-width: 750px) { .ck-circle-cards .ck-cards__grid { grid-template-columns: repeat(var(--ck-cols-tablet), minmax(0, 1fr)); } }
@media screen and (min-width: 990px) { .ck-circle-cards .ck-cards__grid { grid-template-columns: repeat(var(--ck-cols), minmax(0, 1fr)); } }
{% endstylesheet %}

{% javascript %}
document.addEventListener('shopify:section:load', () => {});
document.addEventListener('shopify:section:unload', () => {});
{% endjavascript %}

