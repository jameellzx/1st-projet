{%- liquid
  assign hf = section.settings.heading_font
  assign bf = section.settings.body_font
-%}
<style>
  #shopify-section-{{ section.id }} {
    --ck-heading-font: {{ hf.family }}, {{ hf.fallback_families }};
    --ck-body-font: {{ bf.family }}, {{ bf.fallback_families }};
  }
  {{ hf | font_face: font_display: 'swap' }}
  {{ bf | font_face: font_display: 'swap' }}
</style>
<div class="color-{{ section.settings.color_scheme }} ck-scheme">
<div class="ck-rich-media" style="
    --ck-bg: {{ section.settings.background_color }};
    --ck-fg: {{ section.settings.text_color }};
    --ck-heading-color: {{ section.settings.heading_color }};
    --ck-btn-bg: {{ section.settings.button_background }};
    --ck-btn-fg: {{ section.settings.button_text }};
    --ck-btn-bg-hover: {{ section.settings.button_hover_background }};
    --ck-btn-border: {{ section.settings.button_border }};
    --ck-btn-border-w: {{ section.settings.button_border_width }}px;
    --ck-h-size: {{ section.settings.heading_size }}px;
    --ck-h-size-m: {{ section.settings.heading_size_mobile }}px;
    --ck-h-weight: {{ section.settings.heading_weight }};
    --ck-h-lh: {{ section.settings.heading_line_height }};
    --ck-h-ls: {{ section.settings.heading_letter_spacing }}em;
    --ck-h-tt: {{ section.settings.heading_text_transform }};
    --ck-b-size: {{ section.settings.body_size }}px;
    --ck-b-size-m: {{ section.settings.body_size_mobile }}px;
    --ck-b-lh: {{ section.settings.body_line_height }};
    --ck-btn-size: {{ section.settings.button_size }}px;
    --ck-btn-weight: {{ section.settings.button_weight }};
    --ck-btn-tt: {{ section.settings.button_text_transform }};
    --ck-btn-ls: {{ section.settings.button_letter_spacing }}em;
    --ck-pad-top: {{ section.settings.padding_top }}px;
    --ck-pad-bottom: {{ section.settings.padding_bottom }}px;
    --ck-pad-top-m: {{ section.settings.padding_top_mobile }}px;
    --ck-pad-bottom-m: {{ section.settings.padding_bottom_mobile }}px;
    --ck-max-width: {{ section.settings.content_width }}px;
    --ck-gutter: {{ section.settings.side_padding }}px;
    --ck-align: {{ section.settings.text_alignment }};
    --ck-radius: {{ section.settings.corner_radius }}px;
    --ck-btn-px: {{ section.settings.button_padding_x }}px;
    --ck-btn-py: {{ section.settings.button_padding_y }}px;
    --ck-anim-dur: {{ section.settings.animation_duration }}ms;
    --ck-anim-distance: {{ section.settings.animation_distance }}px;
    --ck-media-max: {{ section.settings.media_width }}px;
    --ck-media-ratio: {{ section.settings.media_ratio }};
    --ck-text-gap: {{ section.settings.text_gap }}px;
    --ck-link-color: {{ section.settings.link_color }};
    --ck-link-size: {{ section.settings.link_size }}px;
  " data-animate="{{ section.settings.animation_style }}"
  {%- if section.settings.full_width %} data-full-width{% endif %}
  {%- unless section.settings.show_on_mobile %} data-hide-mobile{% endunless %}
  {%- unless section.settings.show_on_desktop %} data-hide-desktop{% endunless %}
>
<div class="ck-inner">
  {%- if section.settings.heading != blank -%}<h2 class="ck-heading ck-rm__heading">{{ section.settings.heading }}</h2>{%- endif -%}
  {%- if section.settings.text != blank -%}<div class="ck-text ck-rm__text">{{ section.settings.text }}</div>{%- endif -%}
  <div class="ck-rm__media">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: image_size: '1100x', autoplay: section.settings.video_autoplay, loop: section.settings.video_autoplay, muted: section.settings.video_autoplay, controls: section.settings.video_controls, class: 'ck-rm__video' }}
    {%- elsif section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: widths: '375, 550, 750, 1100, 1500', sizes: '(min-width: 990px) 60vw, 100vw', class: 'ck-rm__img', loading: lazy }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'ck-rm__img' }}
    {%- endif -%}
  </div>
  {%- if section.settings.link_label != blank -%}
    <a class="{% if section.settings.link_style == 'button' %}ck-btn{% else %}ck-rm__link{% endif %} ck-rm__cta" href="{{ section.settings.link | default: routes.root_url }}">{{ section.settings.link_label | escape }}</a>
  {%- endif -%}
</div>
</div>
</div>

{% stylesheet %}
.ck-rich-media { background: var(--ck-bg); color: var(--ck-fg); font-family: var(--ck-body-font); font-size: var(--ck-b-size-m); line-height: var(--ck-b-lh); padding-top: var(--ck-pad-top-m); padding-bottom: var(--ck-pad-bottom-m); text-align: var(--ck-align); }
.ck-rich-media .ck-inner { max-width: var(--ck-max-width); margin: 0 auto; padding-left: var(--ck-gutter); padding-right: var(--ck-gutter); }
.ck-rich-media[data-full-width] .ck-inner { max-width: 100%; }
.ck-rich-media .ck-heading { font-family: var(--ck-heading-font); font-size: var(--ck-h-size-m); font-weight: var(--ck-h-weight); line-height: var(--ck-h-lh); letter-spacing: var(--ck-h-ls); text-transform: var(--ck-h-tt); color: var(--ck-heading-color); margin: 0; }
.ck-rich-media .ck-text p { margin: 0; }
.ck-rich-media .ck-btn { display: inline-block; background: var(--ck-btn-bg); color: var(--ck-btn-fg); border: var(--ck-btn-border-w) solid var(--ck-btn-border); border-radius: var(--ck-radius); padding: var(--ck-btn-py) var(--ck-btn-px); font-family: var(--ck-body-font); font-size: var(--ck-btn-size); font-weight: var(--ck-btn-weight); text-transform: var(--ck-btn-tt); letter-spacing: var(--ck-btn-ls); line-height: 1.2; text-decoration: none; cursor: pointer; transition: background-color var(--ck-anim-dur) ease; }
.ck-rich-media .ck-btn:hover { background: var(--ck-btn-bg-hover); }
.ck-rich-media[data-animate="fade"] .ck-inner { animation: ck-fade var(--ck-anim-dur) ease both; }
.ck-rich-media[data-animate="slide"] .ck-inner { animation: ck-slide var(--ck-anim-dur) ease both; }
@keyframes ck-fade { from { opacity: 0; } to { opacity: 1; } }
@keyframes ck-slide { from { opacity: 0; transform: translateY(var(--ck-anim-distance)); } to { opacity: 1; transform: none; } }
@media screen and (max-width: 749px) { .ck-rich-media[data-hide-mobile] { display: none; } }
@media screen and (min-width: 750px) {
  .ck-rich-media { font-size: var(--ck-b-size); padding-top: var(--ck-pad-top); padding-bottom: var(--ck-pad-bottom); }
  .ck-rich-media .ck-heading { font-size: var(--ck-h-size); }
  .ck-rich-media[data-hide-desktop] { display: none; }
}
/* reduced motion must beat every animation rule above, including Dawn's */
@media (prefers-reduced-motion: reduce) { .ck-rich-media * { animation: none !important; transition: none !important; } }

.ck-rich-media .ck-rm__text { margin-top: var(--ck-text-gap); }
.ck-rich-media .ck-rm__media { max-width: var(--ck-media-max); margin: var(--ck-text-gap) auto 0; aspect-ratio: var(--ck-media-ratio); overflow: hidden; border-radius: var(--ck-radius); }
.ck-rich-media .ck-rm__img, .ck-rich-media .ck-rm__video { width: 100%; height: 100%; object-fit: cover; display: block; }
.ck-rich-media .ck-rm__cta { display: inline-block; margin-top: var(--ck-text-gap); }
.ck-rich-media .ck-rm__link { color: var(--ck-link-color); font-size: var(--ck-link-size); font-weight: var(--ck-btn-weight); text-decoration: none; }
.ck-rich-media .ck-rm__link:hover { text-decoration: underline; }
{% endstylesheet %}

{% javascript %}
document.addEventListener('shopify:section:load', () => {});
document.addEventListener('shopify:section:unload', () => {});
{% endjavascript %}

{% schema %}
{
  "name": "Clone: text + media",
  "tag": "section",
  "class": "ck-section",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "We know you'll love these products as much as we do!"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video (Shopify hosted)"
    },
    {
      "type": "checkbox",
      "id": "video_autoplay",
      "label": "Autoplay video (muted, looping)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "video_controls",
      "label": "Show video controls",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (used when no video)"
    },
    {
      "type": "range",
      "id": "media_width",
      "label": "Media width",
      "min": 240,
      "max": 1400,
      "step": 20,
      "default": 820,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Media shape",
      "default": "16 / 9",
      "options": [
        {
          "value": "16 / 9",
          "label": "Wide"
        },
        {
          "value": "4 / 3",
          "label": "Landscape"
        },
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "auto",
          "label": "Original"
        }
      ]
    },
    {
      "type": "range",
      "id": "text_gap",
      "label": "Space between items",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "text",
