{%- liquid
  assign hf = section.settings.heading_font
  assign bf = section.settings.body_font
-%}
<style>
  #shopify-section-{{ section.id }} {
    --ck-heading-font: {{ hf.family }}, var(--ck-ar-font, sans-serif), {{ hf.fallback_families }};
    --ck-body-font: {{ bf.family }}, var(--ck-ar-font, sans-serif), {{ bf.fallback_families }};
  }
  {{ hf | font_face: font_display: 'swap' }}
  {{ bf | font_face: font_display: 'swap' }}
</style>
<div class="color-{{ section.settings.color_scheme }} ck-scheme">
<div class="ck-ec-cards" style="
    --ck-bg: {{ section.settings.background_color }};
    --ck-fg: {{ section.settings.text_color }};
    --ck-heading-color: {{ section.settings.heading_color }};
    --ck-btn-bg: {{ section.settings.button_background }};
    --ck-btn-fg: {{ section.settings.button_text }};
    --ck-btn-bg-hover: {{ section.settings.button_hover_background }};
    --ck-btn-border: {{ section.settings.button_border }};
    --ck-btn-border-w: {{ section.settings.button_border_width }}px;
    --ck-h-size: {{ section.settings.heading_size }}px;
    --ck-h-size-m: {{ section.settings.heading_size_mobile }}px;
    --ck-h-weight: {{ section.settings.heading_weight }};
    --ck-h-lh: {{ section.settings.heading_line_height }};
    --ck-h-ls: {{ section.settings.heading_letter_spacing }}em;
    --ck-h-tt: {{ section.settings.heading_text_transform }};
    --ck-b-size: {{ section.settings.body_size }}px;
    --ck-b-size-m: {{ section.settings.body_size_mobile }}px;
    --ck-b-lh: {{ section.settings.body_line_height }};
    --ck-btn-size: {{ section.settings.button_size }}px;
    --ck-btn-weight: {{ section.settings.button_weight }};
    --ck-btn-tt: {{ section.settings.button_text_transform }};
    --ck-btn-ls: {{ section.settings.button_letter_spacing }}em;
    --ck-pad-top: {{ section.settings.padding_top }}px;
    --ck-pad-bottom: {{ section.settings.padding_bottom }}px;
    --ck-pad-top-m: {{ section.settings.padding_top_mobile }}px;
    --ck-pad-bottom-m: {{ section.settings.padding_bottom_mobile }}px;
    --ck-max-width: {{ section.settings.content_width }}px;
    --ck-gutter: {{ section.settings.side_padding }}px;
    --ck-align: {{ section.settings.text_alignment }};
    --ck-radius: {{ section.settings.corner_radius }}px;
    --ck-btn-px: {{ section.settings.button_padding_x }}px;
    --ck-btn-py: {{ section.settings.button_padding_y }}px;
    --ck-anim-dur: {{ section.settings.animation_duration }}ms;
    --ck-anim-distance: {{ section.settings.animation_distance }}px;
    --ck-small: {{ section.settings.small_text_size }}px;
    --ck-large: {{ section.settings.large_text_size }}px;
    --ck-chip-px: {{ section.settings.chip_padding_x }}px;
    --ck-chip-py: {{ section.settings.chip_padding_y }}px;
    --ck-num-size: {{ section.settings.number_size }}px;
    --ck-head-gap: {{ section.settings.head_gap }}px;
    --ck-sub-gap: {{ section.settings.sub_gap }}px;
    --ck-cols: {{ section.settings.columns_desktop }};
    --ck-cols-tablet: {{ section.settings.columns_tablet }};
    --ck-cols-mobile: {{ section.settings.columns_mobile }};
    --ck-gap: {{ section.settings.gap }}px;
    --ck-proof-fg: {{ section.settings.proof_color }};
    --ck-proof-bg: {{ section.settings.proof_background }};
    --ck-img-size: {{ section.settings.image_size }}px;
    --ck-img-size-m: {{ section.settings.image_size_mobile }}px;
    --ck-card-pad: {{ section.settings.card_padding }}px;
    --ck-card-radius: {{ section.settings.card_radius }}px;
    --ck-card-bg-d: {{ section.settings.card_background }};
    --ck-card-border: {{ section.settings.card_border }};
    --ck-card-align: {{ section.settings.card_alignment }};
    --ck-title-size: {{ section.settings.title_size }}px;
    --ck-title-size-m: {{ section.settings.title_size_mobile }}px;
    --ck-title-weight: {{ section.settings.title_weight }};
    --ck-num-bg: {{ section.settings.number_background }};
    --ck-num-fg: {{ section.settings.number_color }};
    --ck-item-gap: {{ section.settings.item_gap }}px;
    --ck-foot-gap: {{ section.settings.footer_gap }}px;
    --ck-foot-color: {{ section.settings.footer_color }};
    --ck-intro-w: {{ section.settings.intro_width }}px;
  " data-animate="{{ section.settings.animation_style }}"
  {%- if section.settings.full_width %} data-full-width{% endif %}
  {%- unless section.settings.show_on_mobile %} data-hide-mobile{% endunless %}
  {%- unless section.settings.show_on_desktop %} data-hide-desktop{% endunless %}
>
<div class="ck-inner">
  
{%- if section.settings.heading != blank or section.settings.subheading != blank -%}
<div class="ck-head">
  {%- if section.settings.heading != blank -%}<h2 class="ck-heading">{{ section.settings.heading }}</h2>{%- endif -%}
  {%- if section.settings.subheading != blank -%}<div class="ck-text ck-sub">{{ section.settings.subheading }}</div>{%- endif -%}
</div>
{%- endif -%}

  {%- if section.settings.intro != blank -%}<div class="ck-text ck-cards__intro">{{ section.settings.intro }}</div>{%- endif -%}
  <div class="ck-cards" data-shape="{{ section.settings.image_shape }}">
    {%- for block in section.blocks -%}
      <div class="ck-card{% if block.settings.dashed %} ck-card--dashed{% endif %}" style="{% if block.settings.card_background != blank %}--ck-card-bg: {{ block.settings.card_background }};{% endif %}" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank or block.settings.image_asset != blank -%}
          <div class="ck-card__media">{%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 1600 | image_tag: widths: '375, 550, 750, 1100, 1500', sizes: '240px', class: 'ck-card__img', loading: 'lazy', alt: block.settings.image_alt }}{%- elsif block.settings.image_asset != blank -%}<img src="{{ block.settings.image_asset | asset_url }}" class="ck-card__img" alt="{{ block.settings.image_alt | escape }}" loading="lazy">{%- else -%}{{ 'image' | placeholder_svg_tag: 'ck-card__img' }}{%- endif -%}</div>
        {%- endif -%}
        {%- if block.settings.number != blank -%}<span class="ck-card__num">{{ block.settings.number | escape }}</span>{%- endif -%}
        {%- if block.settings.title != blank -%}<h3 class="ck-card__title">{{ block.settings.title }}</h3>{%- endif -%}
        {%- if block.settings.text != blank -%}<div class="ck-text ck-card__text">{{ block.settings.text }}</div>{%- endif -%}
        {%- if block.settings.show_proof -%}<span class="ck-proof">{{ settings.ck_proof_label }}{%- if block.settings.proof_note != blank %} {{ block.settings.proof_note }}{% endif -%}</span>{%- endif -%}
        {%- if block.settings.link_label != blank -%}<a class="ck-card__link" href="{{ block.settings.link | default: '#' }}">{{ block.settings.link_label | escape }}</a>{%- endif -%}
      </div>
    {%- endfor -%}
  </div>
  {%- if section.settings.footer_text != blank -%}<div class="ck-text ck-cards__foot">{{ section.settings.footer_text }}</div>{%- endif -%}
  {%- if section.settings.button_label != blank -%}<div class="ck-cards__cta"><a class="ck-btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a></div>{%- endif -%}
</div>
</div>
</div>

{% stylesheet %}
.ck-ec-cards { background: var(--ck-bg); color: var(--ck-fg); font-family: var(--ck-body-font); font-size: var(--ck-b-size-m); line-height: var(--ck-b-lh); padding-top: var(--ck-pad-top-m); padding-bottom: var(--ck-pad-bottom-m); text-align: var(--ck-align); }
.ck-ec-cards ck-scroller { display: block; }
.ck-ec-cards .ck-inner { max-width: var(--ck-max-width); margin: 0 auto; padding-left: var(--ck-gutter); padding-right: var(--ck-gutter); }
.ck-ec-cards[data-full-width] .ck-inner { max-width: 100%; }
.ck-ec-cards .ck-heading { font-family: var(--ck-heading-font); font-size: var(--ck-h-size-m); font-weight: var(--ck-h-weight); line-height: var(--ck-h-lh); letter-spacing: var(--ck-h-ls); text-transform: var(--ck-h-tt); color: var(--ck-heading-color); margin: 0; }
.ck-ec-cards .ck-text p { margin: 0; }
.ck-ec-cards .ck-btn { display: inline-block; background: var(--ck-btn-bg); color: var(--ck-btn-fg); border: var(--ck-btn-border-w) solid var(--ck-btn-border); border-radius: var(--ck-radius); padding: var(--ck-btn-py) var(--ck-btn-px); font-family: var(--ck-body-font); font-size: var(--ck-btn-size); font-weight: var(--ck-btn-weight); text-transform: var(--ck-btn-tt); letter-spacing: var(--ck-btn-ls); line-height: 1.2; text-decoration: none; cursor: pointer; transition: background-color var(--ck-anim-dur) ease; }
.ck-ec-cards .ck-btn:hover { background: var(--ck-btn-bg-hover); }
.ck-ec-cards[data-animate="fade"] .ck-inner { animation: ck-fade var(--ck-anim-dur) ease both; }
.ck-ec-cards[data-animate="slide"] .ck-inner { animation: ck-slide var(--ck-anim-dur) ease both; }
@keyframes ck-fade { from { opacity: 0; } to { opacity: 1; } }
@keyframes ck-slide { from { opacity: 0; transform: translateY(var(--ck-anim-distance)); } to { opacity: 1; transform: none; } }
@media screen and (max-width: 749px) { .ck-ec-cards[data-hide-mobile] { display: none; } }
@media screen and (min-width: 750px) {
  .ck-ec-cards { font-size: var(--ck-b-size); padding-top: var(--ck-pad-top); padding-bottom: var(--ck-pad-bottom); }
  .ck-ec-cards .ck-heading { font-size: var(--ck-h-size); }
  .ck-ec-cards[data-hide-desktop] { display: none; }
}
/* reduced motion must beat every animation rule above, including Dawn's */
@media (prefers-reduced-motion: reduce) { .ck-ec-cards * { animation: none !important; transition: none !important; } }

.ck-ec-cards .ck-head { margin-bottom: var(--ck-head-gap); }
.ck-ec-cards .ck-sub { margin-top: var(--ck-sub-gap); }

.ck-ec-cards .ck-proof { display: inline-block; margin: var(--ck-proof-gap, 6px) 0 0; padding: var(--ck-chip-py) var(--ck-chip-px); border: 1px dashed var(--ck-proof-fg); border-radius: var(--ck-radius); background: var(--ck-proof-bg); color: var(--ck-proof-fg); font-size: var(--ck-small); line-height: 1.6; }

.ck-ec-cards .ck-cards__intro { max-width: var(--ck-intro-w); margin: 0 auto var(--ck-head-gap); }
.ck-ec-cards .ck-cards { display: grid; gap: var(--ck-gap); grid-template-columns: repeat(var(--ck-cols-mobile), minmax(0, 1fr)); }
.ck-ec-cards .ck-card { display: flex; flex-direction: column; align-items: var(--ck-card-align); text-align: var(--ck-card-align); gap: var(--ck-item-gap); padding: var(--ck-card-pad); border-radius: var(--ck-card-radius); background: var(--ck-card-bg, var(--ck-card-bg-d)); }
.ck-ec-cards .ck-card--dashed { border: 2px dashed var(--ck-card-border); }
.ck-ec-cards .ck-card__media { width: var(--ck-img-size-m); max-width: 100%; aspect-ratio: 1; overflow: hidden; border-radius: var(--ck-card-radius); }
.ck-ec-cards .ck-cards[data-shape="circle"] .ck-card__media { border-radius: 50%; }
.ck-ec-cards .ck-cards[data-shape="square"] .ck-card__media { border-radius: 0; }
.ck-ec-cards .ck-card__img { width: 100%; height: 100%; object-fit: cover; display: block; }
.ck-ec-cards .ck-card__num { display: inline-flex; align-items: center; justify-content: center; min-width: var(--ck-num-size); height: var(--ck-num-size); border-radius: 50%; background: var(--ck-num-bg); color: var(--ck-num-fg); font-weight: var(--ck-btn-weight); }
.ck-ec-cards .ck-card__title { margin: 0; font-family: var(--ck-heading-font); font-size: var(--ck-title-size-m); font-weight: var(--ck-title-weight); line-height: var(--ck-h-lh); color: var(--ck-heading-color); }
.ck-ec-cards .ck-card__link { color: var(--ck-heading-color); font-weight: var(--ck-btn-weight); }
.ck-ec-cards .ck-cards__foot { margin-top: var(--ck-foot-gap); color: var(--ck-foot-color); font-size: var(--ck-large); }
.ck-ec-cards .ck-cards__cta { margin-top: var(--ck-foot-gap); }
@media screen and (min-width: 750px) { .ck-ec-cards .ck-cards { grid-template-columns: repeat(var(--ck-cols-tablet), minmax(0, 1fr)); } }
@media screen and (min-width: 990px) {
  .ck-ec-cards .ck-cards { grid-template-columns: repeat(var(--ck-cols), minmax(0, 1fr)); }
  .ck-ec-cards .ck-card__media { width: var(--ck-img-size); }
  .ck-ec-cards .ck-card__title { font-size: var(--ck-title-size); }
}
{% endstylesheet %}

{% javascript %}
document.addEventListener('shopify:section:load', () => {});
document.addEventListener('shopify:section:unload', () => {});
{% endjavascript %}

{% schema %}
{
  "name": "EC: cards",
  "tag": "section",
  "class": "ck-section",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Heading"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "range",
      "id": "head_gap",
      "label": "Space under heading",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "sub_gap",
      "label": "Space between heading and subheading",
      "min": 0,
      "max": 40,
      "step": 1,
      "default": 10,
      "unit": "px"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text"
    },
    {
      "type": "range",
      "id": "intro_width",
      "label": "Intro max width",
      "min": 300,
      "max": 1200,
      "step": 10,
      "default": 760,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Columns (tablet)",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 1
    },
    {
