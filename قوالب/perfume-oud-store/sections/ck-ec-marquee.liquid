      "max": 12,
      "step": 1,
      "default": 3,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "number_size",
      "label": "Number circle size",
      "min": 20,
      "max": 60,
      "step": 1,
      "default": 34,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Visibility and animation"
    },
    {
      "type": "checkbox",
      "id": "show_on_desktop",
      "label": "Show on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "Show on mobile",
      "default": true
    },
    {
      "type": "select",
      "id": "animation_style",
      "label": "Entrance animation",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fade",
          "label": "Fade in"
        },
        {
          "value": "slide",
          "label": "Slide up"
        }
      ]
    },
    {
      "type": "range",
      "id": "animation_duration",
      "label": "Animation duration",
      "min": 0,
      "max": 1500,
      "step": 50,
      "default": 600,
      "unit": "ms"
    },
    {
      "type": "range",
      "id": "animation_distance",
      "label": "Slide distance",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 24,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Text item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "نص"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "color",
          "id": "item_color",
          "label": "Text color (optional)"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "EC: scrolling text",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %}
