{%- liquid
  assign hf = section.settings.heading_font
  assign bf = section.settings.body_font
-%}
<style>
  #shopify-section-{{ section.id }} {
    --ck-heading-font: {{ hf.family }}, var(--ck-ar-font, sans-serif), {{ hf.fallback_families }};
    --ck-body-font: {{ bf.family }}, var(--ck-ar-font, sans-serif), {{ bf.fallback_families }};
  }
  {{ hf | font_face: font_display: 'swap' }}
  {{ bf | font_face: font_display: 'swap' }}
</style>
<div class="color-{{ section.settings.color_scheme }} ck-scheme">
<div class="ck-ec-marquee" style="
    --ck-bg: {{ section.settings.background_color }};
    --ck-fg: {{ section.settings.text_color }};
    --ck-heading-color: {{ section.settings.heading_color }};
    --ck-btn-bg: {{ section.settings.button_background }};
    --ck-btn-fg: {{ section.settings.button_text }};
    --ck-btn-bg-hover: {{ section.settings.button_hover_background }};
    --ck-btn-border: {{ section.settings.button_border }};
    --ck-btn-border-w: {{ section.settings.button_border_width }}px;
    --ck-h-size: {{ section.settings.heading_size }}px;
    --ck-h-size-m: {{ section.settings.heading_size_mobile }}px;
    --ck-h-weight: {{ section.settings.heading_weight }};
    --ck-h-lh: {{ section.settings.heading_line_height }};
    --ck-h-ls: {{ section.settings.heading_letter_spacing }}em;
    --ck-h-tt: {{ section.settings.heading_text_transform }};
    --ck-b-size: {{ section.settings.body_size }}px;
    --ck-b-size-m: {{ section.settings.body_size_mobile }}px;
    --ck-b-lh: {{ section.settings.body_line_height }};
    --ck-btn-size: {{ section.settings.button_size }}px;
    --ck-btn-weight: {{ section.settings.button_weight }};
    --ck-btn-tt: {{ section.settings.button_text_transform }};
    --ck-btn-ls: {{ section.settings.button_letter_spacing }}em;
    --ck-pad-top: {{ section.settings.padding_top }}px;
    --ck-pad-bottom: {{ section.settings.padding_bottom }}px;
    --ck-pad-top-m: {{ section.settings.padding_top_mobile }}px;
    --ck-pad-bottom-m: {{ section.settings.padding_bottom_mobile }}px;
    --ck-max-width: {{ section.settings.content_width }}px;
    --ck-gutter: {{ section.settings.side_padding }}px;
    --ck-align: {{ section.settings.text_alignment }};
    --ck-radius: {{ section.settings.corner_radius }}px;
    --ck-btn-px: {{ section.settings.button_padding_x }}px;
    --ck-btn-py: {{ section.settings.button_padding_y }}px;
    --ck-anim-dur: {{ section.settings.animation_duration }}ms;
    --ck-anim-distance: {{ section.settings.animation_distance }}px;
    --ck-small: {{ section.settings.small_text_size }}px;
    --ck-large: {{ section.settings.large_text_size }}px;
    --ck-chip-px: {{ section.settings.chip_padding_x }}px;
    --ck-chip-py: {{ section.settings.chip_padding_y }}px;
    --ck-num-size: {{ section.settings.number_size }}px;
    --ck-marquee-dur: {{ section.settings.speed }}s;
    --ck-marquee-dir: {{ section.settings.direction }};
    --ck-item-gap: {{ section.settings.item_gap }}px;
    --ck-icon-size: {{ section.settings.icon_size }}px;
    --ck-marquee-play: {% if section.settings.pause_on_hover %}paused{% else %}running{% endif %};
  " data-animate="{{ section.settings.animation_style }}"
  {%- if section.settings.full_width %} data-full-width{% endif %}
  {%- unless section.settings.show_on_mobile %} data-hide-mobile{% endunless %}
  {%- unless section.settings.show_on_desktop %} data-hide-desktop{% endunless %}
>
<div class="ck-marquee__viewport" aria-label="{{ section.settings.aria_label | escape }}">
  <div class="ck-marquee__track">
    {%- for i in (1..section.settings.repeat_count) -%}
      <div class="ck-marquee__group"{% unless forloop.first %} aria-hidden="true"{% endunless %}>
        {%- for block in section.blocks -%}
          <span class="ck-marquee__item" style="{% if block.settings.item_color != blank %}--ck-item-color: {{ block.settings.item_color }};{% endif %}" {% if forloop.parentloop.first %}{{ block.shopify_attributes }}{% endif %}>
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>{%- else -%}{{ block.settings.text | escape }}{%- endif -%}
          </span>
          <span class="ck-marquee__sep" aria-hidden="true">{%- if section.settings.sep_image != blank -%}{{ section.settings.sep_image | image_url: width: 1600 | image_tag: widths: '375, 550, 750, 1100, 1500', sizes: '64px', class: 'ck-marquee__icon', loading: 'lazy', alt: section.settings.sep_image_alt }}{%- elsif section.settings.sep_image_asset != blank -%}<img src="{{ section.settings.sep_image_asset | asset_url }}" class="ck-marquee__icon" alt="{{ section.settings.sep_image_alt | escape }}" loading="lazy">{%- else -%}{{ 'image' | placeholder_svg_tag: 'ck-marquee__icon' }}{%- endif -%}</span>
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>
</div>
</div>

{% stylesheet %}
.ck-ec-marquee { background: var(--ck-bg); color: var(--ck-fg); font-family: var(--ck-body-font); font-size: var(--ck-b-size-m); line-height: var(--ck-b-lh); padding-top: var(--ck-pad-top-m); padding-bottom: var(--ck-pad-bottom-m); text-align: var(--ck-align); }
.ck-ec-marquee ck-scroller { display: block; }
.ck-ec-marquee .ck-inner { max-width: var(--ck-max-width); margin: 0 auto; padding-left: var(--ck-gutter); padding-right: var(--ck-gutter); }
.ck-ec-marquee[data-full-width] .ck-inner { max-width: 100%; }
.ck-ec-marquee .ck-heading { font-family: var(--ck-heading-font); font-size: var(--ck-h-size-m); font-weight: var(--ck-h-weight); line-height: var(--ck-h-lh); letter-spacing: var(--ck-h-ls); text-transform: var(--ck-h-tt); color: var(--ck-heading-color); margin: 0; }
.ck-ec-marquee .ck-text p { margin: 0; }
.ck-ec-marquee .ck-btn { display: inline-block; background: var(--ck-btn-bg); color: var(--ck-btn-fg); border: var(--ck-btn-border-w) solid var(--ck-btn-border); border-radius: var(--ck-radius); padding: var(--ck-btn-py) var(--ck-btn-px); font-family: var(--ck-body-font); font-size: var(--ck-btn-size); font-weight: var(--ck-btn-weight); text-transform: var(--ck-btn-tt); letter-spacing: var(--ck-btn-ls); line-height: 1.2; text-decoration: none; cursor: pointer; transition: background-color var(--ck-anim-dur) ease; }
.ck-ec-marquee .ck-btn:hover { background: var(--ck-btn-bg-hover); }
.ck-ec-marquee[data-animate="fade"] .ck-inner { animation: ck-fade var(--ck-anim-dur) ease both; }
.ck-ec-marquee[data-animate="slide"] .ck-inner { animation: ck-slide var(--ck-anim-dur) ease both; }
@keyframes ck-fade { from { opacity: 0; } to { opacity: 1; } }
@keyframes ck-slide { from { opacity: 0; transform: translateY(var(--ck-anim-distance)); } to { opacity: 1; transform: none; } }
@media screen and (max-width: 749px) { .ck-ec-marquee[data-hide-mobile] { display: none; } }
@media screen and (min-width: 750px) {
  .ck-ec-marquee { font-size: var(--ck-b-size); padding-top: var(--ck-pad-top); padding-bottom: var(--ck-pad-bottom); }
  .ck-ec-marquee .ck-heading { font-size: var(--ck-h-size); }
  .ck-ec-marquee[data-hide-desktop] { display: none; }
}
/* reduced motion must beat every animation rule above, including Dawn's */
@media (prefers-reduced-motion: reduce) { .ck-ec-marquee .ck-inner { animation: none !important; transition: none !important; } }
/* the strip always moves (store owner's choice), just slower when the phone asks for less motion */
@media (prefers-reduced-motion: reduce) { .ck-ec-marquee .ck-marquee__track { animation-duration: calc(var(--ck-marquee-dur) * 1.5) !important; } }

.ck-ec-marquee .ck-marquee__viewport { overflow: hidden; white-space: nowrap; direction: ltr; }
.ck-ec-marquee .ck-marquee__track { display: inline-flex; animation: ck-marquee var(--ck-marquee-dur) linear infinite; animation-direction: var(--ck-marquee-dir); }
.ck-ec-marquee .ck-marquee__viewport:hover .ck-marquee__track { animation-play-state: var(--ck-marquee-play); }
.ck-ec-marquee .ck-marquee__group { display: inline-flex; align-items: center; flex-shrink: 0; }
.ck-ec-marquee .ck-marquee__item { padding: 0 var(--ck-item-gap); font-family: var(--ck-heading-font); font-size: var(--ck-h-size-m); font-weight: var(--ck-h-weight); line-height: var(--ck-h-lh); color: var(--ck-item-color, var(--ck-heading-color)); direction: rtl; }
.ck-ec-marquee .ck-marquee__item a { color: inherit; text-decoration: none; }
.ck-ec-marquee .ck-marquee__sep { display: inline-flex; }
.ck-ec-marquee .ck-marquee__icon { width: var(--ck-icon-size); height: var(--ck-icon-size); object-fit: contain; display: block; }
@keyframes ck-marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
@media screen and (min-width: 750px) { .ck-ec-marquee .ck-marquee__item { font-size: var(--ck-h-size); } }
{% endstylesheet %}

{% javascript %}
document.addEventListener('shopify:section:load', () => {});
document.addEventListener('shopify:section:unload', () => {});
{% endjavascript %}

{% schema %}
{
  "name": "EC: scrolling text",
  "tag": "section",
  "class": "ck-section",
  "settings": [
    {
      "type": "header",
      "content": "Scrolling text"
    },
    {
      "type": "image_picker",
      "id": "sep_image",
      "label": "Separator icon"
    },
    {
      "type": "text",
      "id": "sep_image_asset",
      "label": "Separator icon: fallback theme asset (file in assets/)",
      "default": "ec-star.png"
    },
    {
      "type": "text",
      "id": "sep_image_alt",
      "label": "Separator icon: alt text"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 8,
      "max": 64,
      "step": 2,
      "default": 32,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Seconds per loop",
      "min": 5,
      "max": 120,
      "step": 5,
      "default": 40,
      "unit": "s"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "default": "normal",
      "options": [
        {
          "value": "normal",
          "label": "Right to left"
        },
        {
          "value": "reverse",
          "label": "Left to right"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "range",
      "id": "item_gap",
      "label": "Space between items",
      "min": 4,
      "max": 60,
      "step": 1,
      "default": 30,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "repeat_count",
      "label": "Repeat text",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Screen reader label",
      "default": "مزايا المتجر"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F4C2C2"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#686868"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Button hover background",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "button_border",
      "label": "Button border",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "button_border_width",
      "label": "Button border width",
      "min": 0,
      "max": 6,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "dm_sans_n5"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "dm_sans_n4"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size (desktop)",
      "min": 12,
      "max": 112,
      "step": 2,
      "default": 32,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 12,
      "max": 72,
      "step": 2,
      "default": 18,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_weight",
      "label": "Heading weight",
      "min": 100,
      "max": 900,
      "step": 100,
      "default": 500
    },
    {
      "type": "range",
      "id": "heading_line_height",
      "label": "Heading line height",
      "min": 0.8,
      "max": 2,
      "step": 0.1,
      "default": 1.2
    },
    {
      "type": "range",
      "id": "heading_letter_spacing",
      "label": "Heading letter spacing",
      "min": -1,
      "max": 3,
      "step": 0.1,
      "default": 0,
      "unit": "em"
    },
    {
      "type": "select",
      "id": "heading_text_transform",
      "label": "Heading case",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "As typed"
        },
        {
          "value": "uppercase",
          "label": "UPPERCASE"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        }
      ]
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Text size (desktop)",
      "min": 10,
      "max": 30,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "body_size_mobile",
      "label": "Text size (mobile)",
      "min": 10,
      "max": 26,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "body_line_height",
      "label": "Text line height",
      "min": 1,
      "max": 2.2,
      "step": 0.1,
      "default": 1.7
    },
    {
      "type": "range",
      "id": "button_size",
      "label": "Button text size",
      "min": 10,
      "max": 24,
      "step": 1,
      "default": 15,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "button_weight",
      "label": "Button weight",
      "min": 100,
      "max": 900,
      "step": 100,
      "default": 700
    },
    {
      "type": "select",
      "id": "button_text_transform",
      "label": "Button case",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "As typed"
        },
        {
          "value": "uppercase",
          "label": "UPPERCASE"
        }
      ]
    },
    {
      "type": "range",
      "id": "button_letter_spacing",
      "label": "Button letter spacing",
      "min": -1,
      "max": 3,
      "step": 0.1,
      "default": 0,
      "unit": "em"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 160,
      "step": 2,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 160,
      "step": 2,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 600,
      "max": 2000,
      "step": 20,
      "default": 1440,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "side_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": true
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 30,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "button_padding_x",
      "label": "Button side padding",
      "min": 4,
      "max": 64,
      "step": 2,
      "default": 32,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "button_padding_y",
      "label": "Button height padding",
      "min": 4,
      "max": 32,
      "step": 2,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Small parts"
    },
    {
      "type": "range",
      "id": "small_text_size",
      "label": "Small text size",
      "min": 10,
      "max": 20,
      "step": 1,
      "default": 12,
