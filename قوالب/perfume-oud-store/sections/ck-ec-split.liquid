{%- liquid
  assign hf = section.settings.heading_font
  assign bf = section.settings.body_font
-%}
<style>
  #shopify-section-{{ section.id }} {
    --ck-heading-font: {{ hf.family }}, var(--ck-ar-font, sans-serif), {{ hf.fallback_families }};
    --ck-body-font: {{ bf.family }}, var(--ck-ar-font, sans-serif), {{ bf.fallback_families }};
  }
  {{ hf | font_face: font_display: 'swap' }}
  {{ bf | font_face: font_display: 'swap' }}
</style>
<div class="color-{{ section.settings.color_scheme }} ck-scheme">
<div class="ck-ec-split" style="
    --ck-bg: {{ section.settings.background_color }};
    --ck-fg: {{ section.settings.text_color }};
    --ck-heading-color: {{ section.settings.heading_color }};
    --ck-btn-bg: {{ section.settings.button_background }};
    --ck-btn-fg: {{ section.settings.button_text }};
    --ck-btn-bg-hover: {{ section.settings.button_hover_background }};
    --ck-btn-border: {{ section.settings.button_border }};
    --ck-btn-border-w: {{ section.settings.button_border_width }}px;
    --ck-h-size: {{ section.settings.heading_size }}px;
    --ck-h-size-m: {{ section.settings.heading_size_mobile }}px;
    --ck-h-weight: {{ section.settings.heading_weight }};
    --ck-h-lh: {{ section.settings.heading_line_height }};
    --ck-h-ls: {{ section.settings.heading_letter_spacing }}em;
    --ck-h-tt: {{ section.settings.heading_text_transform }};
    --ck-b-size: {{ section.settings.body_size }}px;
    --ck-b-size-m: {{ section.settings.body_size_mobile }}px;
    --ck-b-lh: {{ section.settings.body_line_height }};
    --ck-btn-size: {{ section.settings.button_size }}px;
    --ck-btn-weight: {{ section.settings.button_weight }};
    --ck-btn-tt: {{ section.settings.button_text_transform }};
    --ck-btn-ls: {{ section.settings.button_letter_spacing }}em;
    --ck-pad-top: {{ section.settings.padding_top }}px;
    --ck-pad-bottom: {{ section.settings.padding_bottom }}px;
    --ck-pad-top-m: {{ section.settings.padding_top_mobile }}px;
    --ck-pad-bottom-m: {{ section.settings.padding_bottom_mobile }}px;
    --ck-max-width: {{ section.settings.content_width }}px;
    --ck-gutter: {{ section.settings.side_padding }}px;
    --ck-align: {{ section.settings.text_alignment }};
    --ck-radius: {{ section.settings.corner_radius }}px;
    --ck-btn-px: {{ section.settings.button_padding_x }}px;
    --ck-btn-py: {{ section.settings.button_padding_y }}px;
    --ck-anim-dur: {{ section.settings.animation_duration }}ms;
    --ck-anim-distance: {{ section.settings.animation_distance }}px;
    --ck-small: {{ section.settings.small_text_size }}px;
    --ck-large: {{ section.settings.large_text_size }}px;
    --ck-chip-px: {{ section.settings.chip_padding_x }}px;
    --ck-chip-py: {{ section.settings.chip_padding_y }}px;
    --ck-num-size: {{ section.settings.number_size }}px;
    --ck-panel-w: {{ section.settings.panel_width }}%;
    --ck-panel-bg: {{ section.settings.panel_background }};
    --ck-media-bg: {{ section.settings.media_background }};
    --ck-panel-radius: {{ section.settings.panel_radius }}px;
    --ck-panel-pad: {{ section.settings.panel_padding }}px;
    --ck-panel-pad-m: {{ section.settings.panel_padding_mobile }}px;
    --ck-minh: {{ section.settings.min_height }}px;
    --ck-media-h-m: {{ section.settings.media_height_mobile }}px;
    --ck-gap: {{ section.settings.gap }}px;
    --ck-item-gap: {{ section.settings.item_gap }}px;
    --ck-fit: {{ section.settings.image_fit }};
    --ck-badge-bg: {{ section.settings.badge_background }};
    --ck-badge-fg: {{ section.settings.badge_color }};
    --ck-accent: {{ section.settings.accent_color }};
    --ck-panel-align: {{ section.settings.panel_alignment }};
    --ck-panel-max: {{ section.settings.panel_text_width }}px;
    --ck-proof-fg: {{ section.settings.proof_color }};
    --ck-proof-bg: {{ section.settings.proof_background }};
  " data-animate="{{ section.settings.animation_style }}"
  {%- if section.settings.full_width %} data-full-width{% endif %}
  {%- unless section.settings.show_on_mobile %} data-hide-mobile{% endunless %}
  {%- unless section.settings.show_on_desktop %} data-hide-desktop{% endunless %}
>
<div class="ck-inner">
  <div class="ck-split" data-media="{{ section.settings.media_position }}">
    <div class="ck-split__panel">
      {%- if section.settings.badge_text != blank -%}<span class="ck-badge">{{ section.settings.badge_text | escape }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="ck-heading">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="ck-text ck-split__body">{{ section.settings.text }}</div>{%- endif -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'step' -%}
            <div class="ck-step" {{ block.shopify_attributes }}>
              <span class="ck-step__num">{{ block.settings.number | escape }}</span>
              <div class="ck-step__body">
                {%- if block.settings.title != blank -%}<strong class="ck-step__title">{{ block.settings.title }}</strong>{%- endif -%}
                <div class="ck-text">{{ block.settings.text }}</div>
              </div>
            </div>
          {%- when 'timeline' -%}
            <div class="ck-tl{% if block.settings.is_header %} ck-tl--head{% endif %}" style="{% if block.settings.row_color != blank %}--ck-row: {{ block.settings.row_color }};{% endif %}" {{ block.shopify_attributes }}>
              <span class="ck-tl__label">{{ block.settings.label }}</span>
              <span class="ck-tl__cell">{{ block.settings.stage_1 }}</span>
              <span class="ck-tl__cell">{{ block.settings.stage_2 }}</span>
              <span class="ck-tl__cell">{{ block.settings.stage_3 }}</span>
            </div>
          {%- when 'note' -%}
            <div class="ck-note ck-text ck-note--{{ block.settings.style }}" {{ block.shopify_attributes }}>{{ block.settings.text }}{%- if block.settings.show_proof -%}<span class="ck-proof">{{ settings.ck_proof_label }}{%- if block.settings.proof_note != blank %} {{ block.settings.proof_note }}{% endif -%}</span>{%- endif -%}</div>
        {%- endcase -%}
      {%- endfor -%}
      <div class="ck-split__actions">
        {%- if section.settings.button_label != blank -%}<a class="ck-btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>{%- endif -%}
        {%- if section.settings.link2_label != blank -%}<a class="ck-split__link" href="{{ section.settings.link2_link | default: '#' }}">{{ section.settings.link2_label | escape }}</a>{%- endif -%}
      </div>
    </div>
    <div class="ck-split__media">{%- if section.settings.image != blank -%}{{ section.settings.image | image_url: width: 1600 | image_tag: widths: '375, 550, 750, 1100, 1500', sizes: '(min-width: 990px) 50vw, 100vw', class: 'ck-split__img', loading: 'lazy', alt: section.settings.image_alt }}{%- elsif section.settings.image_asset != blank -%}<img src="{{ section.settings.image_asset | asset_url }}" class="ck-split__img" alt="{{ section.settings.image_alt | escape }}" loading="lazy">{%- else -%}{{ 'image' | placeholder_svg_tag: 'ck-split__img' }}{%- endif -%}</div>
  </div>
</div>
</div>
</div>

{% stylesheet %}
.ck-ec-split { background: var(--ck-bg); color: var(--ck-fg); font-family: var(--ck-body-font); font-size: var(--ck-b-size-m); line-height: var(--ck-b-lh); padding-top: var(--ck-pad-top-m); padding-bottom: var(--ck-pad-bottom-m); text-align: var(--ck-align); }
.ck-ec-split ck-scroller { display: block; }
.ck-ec-split .ck-inner { max-width: var(--ck-max-width); margin: 0 auto; padding-left: var(--ck-gutter); padding-right: var(--ck-gutter); }
.ck-ec-split[data-full-width] .ck-inner { max-width: 100%; }
.ck-ec-split .ck-heading { font-family: var(--ck-heading-font); font-size: var(--ck-h-size-m); font-weight: var(--ck-h-weight); line-height: var(--ck-h-lh); letter-spacing: var(--ck-h-ls); text-transform: var(--ck-h-tt); color: var(--ck-heading-color); margin: 0; }
.ck-ec-split .ck-text p { margin: 0; }
.ck-ec-split .ck-btn { display: inline-block; background: var(--ck-btn-bg); color: var(--ck-btn-fg); border: var(--ck-btn-border-w) solid var(--ck-btn-border); border-radius: var(--ck-radius); padding: var(--ck-btn-py) var(--ck-btn-px); font-family: var(--ck-body-font); font-size: var(--ck-btn-size); font-weight: var(--ck-btn-weight); text-transform: var(--ck-btn-tt); letter-spacing: var(--ck-btn-ls); line-height: 1.2; text-decoration: none; cursor: pointer; transition: background-color var(--ck-anim-dur) ease; }
.ck-ec-split .ck-btn:hover { background: var(--ck-btn-bg-hover); }
.ck-ec-split[data-animate="fade"] .ck-inner { animation: ck-fade var(--ck-anim-dur) ease both; }
.ck-ec-split[data-animate="slide"] .ck-inner { animation: ck-slide var(--ck-anim-dur) ease both; }
@keyframes ck-fade { from { opacity: 0; } to { opacity: 1; } }
@keyframes ck-slide { from { opacity: 0; transform: translateY(var(--ck-anim-distance)); } to { opacity: 1; transform: none; } }
@media screen and (max-width: 749px) { .ck-ec-split[data-hide-mobile] { display: none; } }
@media screen and (min-width: 750px) {
  .ck-ec-split { font-size: var(--ck-b-size); padding-top: var(--ck-pad-top); padding-bottom: var(--ck-pad-bottom); }
  .ck-ec-split .ck-heading { font-size: var(--ck-h-size); }
  .ck-ec-split[data-hide-desktop] { display: none; }
}
/* reduced motion must beat every animation rule above, including Dawn's */
@media (prefers-reduced-motion: reduce) { .ck-ec-split * { animation: none !important; transition: none !important; } }

.ck-ec-split .ck-proof { display: inline-block; margin: var(--ck-proof-gap, 6px) 0 0; padding: var(--ck-chip-py) var(--ck-chip-px); border: 1px dashed var(--ck-proof-fg); border-radius: var(--ck-radius); background: var(--ck-proof-bg); color: var(--ck-proof-fg); font-size: var(--ck-small); line-height: 1.6; }

.ck-ec-split .ck-split { display: flex; flex-direction: column; gap: var(--ck-gap); }
.ck-ec-split .ck-split__panel { order: 2; background: var(--ck-panel-bg); border-radius: var(--ck-panel-radius); padding: var(--ck-panel-pad-m); display: flex; flex-direction: column; gap: var(--ck-item-gap); align-items: center; justify-content: center; text-align: var(--ck-panel-align); }
.ck-ec-split .ck-split__panel > * { width: 100%; max-width: var(--ck-panel-max); }
.ck-ec-split .ck-split__panel > .ck-badge { width: auto; }
.ck-ec-split .ck-split__media { order: 1; background: var(--ck-media-bg); border-radius: var(--ck-panel-radius); overflow: hidden; height: var(--ck-media-h-m); }
.ck-ec-split .ck-split__img { width: 100%; height: 100%; object-fit: var(--ck-fit); display: block; }
.ck-ec-split .ck-badge { display: inline-block; background: var(--ck-badge-bg); color: var(--ck-badge-fg); border-radius: var(--ck-radius); padding: var(--ck-chip-py) var(--ck-chip-px); font-weight: var(--ck-btn-weight); font-size: var(--ck-large); }
.ck-ec-split .ck-split__actions { display: flex; flex-wrap: wrap; gap: var(--ck-item-gap); align-items: center; justify-content: center; }
.ck-ec-split .ck-split__link { color: var(--ck-heading-color); font-weight: var(--ck-btn-weight); }
.ck-ec-split .ck-step { display: flex; gap: var(--ck-item-gap); text-align: start; align-items: flex-start; }
.ck-ec-split .ck-step__num { flex: 0 0 auto; width: var(--ck-num-size); height: var(--ck-num-size); border-radius: 50%; background: var(--ck-accent); color: var(--ck-panel-bg); display: inline-flex; align-items: center; justify-content: center; font-weight: var(--ck-btn-weight); }
.ck-ec-split .ck-step__title { color: var(--ck-heading-color); display: block; }
.ck-ec-split .ck-tl { display: grid; grid-template-columns: 1.4fr repeat(3, minmax(0, 1fr)); gap: 1px; background: var(--ck-row, transparent); border-radius: var(--ck-radius); overflow: hidden; text-align: center; font-size: var(--ck-small); }
.ck-ec-split .ck-tl > span { background: var(--ck-bg); padding: var(--ck-chip-px) var(--ck-chip-py); }
.ck-ec-split .ck-tl__label { font-weight: var(--ck-btn-weight); color: var(--ck-heading-color); }
.ck-ec-split .ck-tl--head > span { background: transparent; color: var(--ck-accent); font-weight: var(--ck-btn-weight); }
.ck-ec-split .ck-note--box { background: var(--ck-bg); border-radius: var(--ck-panel-radius); padding: var(--ck-panel-pad-m); }
.ck-ec-split .ck-note--big { font-family: var(--ck-heading-font); font-size: var(--ck-large); color: var(--ck-heading-color); }
@media screen and (min-width: 990px) {
  .ck-ec-split .ck-split { flex-direction: row; min-height: var(--ck-minh); }
  .ck-ec-split .ck-split__panel { flex: 0 0 calc(var(--ck-panel-w) - var(--ck-gap) / 2); padding: var(--ck-panel-pad); order: 1; }
  .ck-ec-split .ck-split__media { flex: 1; height: auto; order: 2; }
  .ck-ec-split .ck-split[data-media="start"] .ck-split__media { order: 0; }
}
{% endstylesheet %}

{% javascript %}
document.addEventListener('shopify:section:load', () => {});
document.addEventListener('shopify:section:unload', () => {});
{% endjavascript %}

{% schema %}
{
  "name": "EC: promo panel + image",
  "tag": "section",
  "class": "ck-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "link2_label",
      "label": "Second link label"
    },
    {
      "type": "url",
      "id": "link2_link",
      "label": "Second link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Image: fallback theme asset (file in assets/)",
      "default": "ec-promo.png"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image: alt text"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "default": "cover",
      "options": [
        {
          "value": "cover",
          "label": "Fill"
        },
        {
          "value": "contain",
          "label": "Fit"
        }
      ]
    },
    {
      "type": "header",
      "content": "Panel"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Image position (desktop)",
      "default": "end",
      "options": [
        {
          "value": "end",
          "label": "After panel"
        },
        {
          "value": "start",
          "label": "Before panel"
        }
      ]
    },
    {
      "type": "range",
      "id": "panel_width",
      "label": "Panel width (desktop)",
      "min": 30,
      "max": 80,
      "step": 1,
      "default": 61,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "panel_text_width",
      "label": "Panel text max width",
      "min": 300,
      "max": 1000,
      "step": 10,
      "default": 760,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "panel_alignment",
      "label": "Panel text alignment",
      "default": "center",
      "options": [
        {
          "value": "start",
          "label": "Start"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "End"
        }
      ]
    },
    {
      "type": "color",
      "id": "panel_background",
      "label": "Panel background",
      "default": "#F5F5DC"
    },
    {
      "type": "color",
      "id": "media_background",
      "label": "Image background",
      "default": "#FFE3D7"
    },
    {
      "type": "range",
      "id": "panel_radius",
      "label": "Panel corner radius",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "panel_padding",
      "label": "Panel padding (desktop)",
      "min": 0,
      "max": 120,
      "step": 2,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "panel_padding_mobile",
      "label": "Panel padding (mobile)",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height (desktop)",
      "min": 0,
      "max": 1000,
      "step": 10,
      "default": 460,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "media_height_mobile",
      "label": "Image height (mobile)",
      "min": 120,
      "max": 600,
      "step": 10,
      "default": 220,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between panel and image",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "item_gap",
      "label": "Space between panel items",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 18,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "badge_background",
      "label": "Badge background",
      "default": "#FF9494"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Badge text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Step number / timeline accent",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Placeholder chips"
    },
    {
      "type": "color",
      "id": "proof_color",
      "label": "Placeholder text",
      "default": "#B4532A"
    },
    {
      "type": "color",
      "id": "proof_background",
      "label": "Placeholder background",
      "default": "#FFF4E8"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#686868"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Button hover background",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "button_border",
      "label": "Button border",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "button_border_width",
      "label": "Button border width",
      "min": 0,
      "max": 6,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "dm_sans_n5"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "dm_sans_n4"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size (desktop)",
      "min": 12,
      "max": 112,
      "step": 2,
      "default": 36,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 12,
      "max": 72,
      "step": 2,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_weight",
      "label": "Heading weight",
      "min": 100,
      "max": 900,
      "step": 100,
      "default": 500
    },
    {
      "type": "range",
      "id": "heading_line_height",
      "label": "Heading line height",
      "min": 0.8,
      "max": 2,
      "step": 0.1,
      "default": 1.2
    },
    {
      "type": "range",
      "id": "heading_letter_spacing",
      "label": "Heading letter spacing",
      "min": -1,
      "max": 3,
      "step": 0.1,
      "default": 0,
      "unit": "em"
    },
    {
      "type": "select",
      "id": "heading_text_transform",
      "label": "Heading case",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "As typed"
        },
        {
          "value": "uppercase",
          "label": "UPPERCASE"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        }
      ]
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Text size (desktop)",
      "min": 10,
      "max": 30,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "body_size_mobile",
      "label": "Text size (mobile)",
      "min": 10,
      "max": 26,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
