{%- liquid
  assign hf = section.settings.heading_font
  assign bf = section.settings.body_font
-%}
<style>
  #shopify-section-{{ section.id }} {
    --ck-heading-font: {{ hf.family }}, var(--ck-ar-font, sans-serif), {{ hf.fallback_families }};
    --ck-body-font: {{ bf.family }}, var(--ck-ar-font, sans-serif), {{ bf.fallback_families }};
  }
  {{ hf | font_face: font_display: 'swap' }}
  {{ bf | font_face: font_display: 'swap' }}
</style>
<div class="color-{{ section.settings.color_scheme }} ck-scheme">
<div class="ck-ec-faq" style="
    --ck-bg: {{ section.settings.background_color }};
    --ck-fg: {{ section.settings.text_color }};
    --ck-heading-color: {{ section.settings.heading_color }};
    --ck-btn-bg: {{ section.settings.button_background }};
    --ck-btn-fg: {{ section.settings.button_text }};
    --ck-btn-bg-hover: {{ section.settings.button_hover_background }};
    --ck-btn-border: {{ section.settings.button_border }};
    --ck-btn-border-w: {{ section.settings.button_border_width }}px;
    --ck-h-size: {{ section.settings.heading_size }}px;
    --ck-h-size-m: {{ section.settings.heading_size_mobile }}px;
    --ck-h-weight: {{ section.settings.heading_weight }};
    --ck-h-lh: {{ section.settings.heading_line_height }};
    --ck-h-ls: {{ section.settings.heading_letter_spacing }}em;
    --ck-h-tt: {{ section.settings.heading_text_transform }};
    --ck-b-size: {{ section.settings.body_size }}px;
    --ck-b-size-m: {{ section.settings.body_size_mobile }}px;
    --ck-b-lh: {{ section.settings.body_line_height }};
    --ck-btn-size: {{ section.settings.button_size }}px;
    --ck-btn-weight: {{ section.settings.button_weight }};
    --ck-btn-tt: {{ section.settings.button_text_transform }};
    --ck-btn-ls: {{ section.settings.button_letter_spacing }}em;
    --ck-pad-top: {{ section.settings.padding_top }}px;
    --ck-pad-bottom: {{ section.settings.padding_bottom }}px;
    --ck-pad-top-m: {{ section.settings.padding_top_mobile }}px;
    --ck-pad-bottom-m: {{ section.settings.padding_bottom_mobile }}px;
    --ck-max-width: {{ section.settings.content_width }}px;
    --ck-gutter: {{ section.settings.side_padding }}px;
    --ck-align: {{ section.settings.text_alignment }};
    --ck-radius: {{ section.settings.corner_radius }}px;
    --ck-btn-px: {{ section.settings.button_padding_x }}px;
    --ck-btn-py: {{ section.settings.button_padding_y }}px;
    --ck-anim-dur: {{ section.settings.animation_duration }}ms;
    --ck-anim-distance: {{ section.settings.animation_distance }}px;
    --ck-small: {{ section.settings.small_text_size }}px;
    --ck-large: {{ section.settings.large_text_size }}px;
    --ck-chip-px: {{ section.settings.chip_padding_x }}px;
    --ck-chip-py: {{ section.settings.chip_padding_y }}px;
    --ck-num-size: {{ section.settings.number_size }}px;
    --ck-head-gap: {{ section.settings.head_gap }}px;
    --ck-sub-gap: {{ section.settings.sub_gap }}px;
    --ck-proof-fg: {{ section.settings.proof_color }};
    --ck-proof-bg: {{ section.settings.proof_background }};
    --ck-faq-w: {{ section.settings.list_width }}px;
    --ck-q-size: {{ section.settings.question_size }}px;
    --ck-q-size-m: {{ section.settings.question_size_mobile }}px;
    --ck-row-pad: {{ section.settings.row_padding }}px;
    --ck-line: {{ section.settings.line_color }};
    --ck-item-bg: {{ section.settings.item_background }};
    --ck-item-radius: {{ section.settings.item_radius }}px;
    --ck-gap: {{ section.settings.gap }}px;
  " data-animate="{{ section.settings.animation_style }}"
  {%- if section.settings.full_width %} data-full-width{% endif %}
  {%- unless section.settings.show_on_mobile %} data-hide-mobile{% endunless %}
  {%- unless section.settings.show_on_desktop %} data-hide-desktop{% endunless %}
>
<div class="ck-inner">
  
{%- if section.settings.heading != blank or section.settings.subheading != blank -%}
<div class="ck-head">
  {%- if section.settings.heading != blank -%}<h2 class="ck-heading">{{ section.settings.heading }}</h2>{%- endif -%}
  {%- if section.settings.subheading != blank -%}<div class="ck-text ck-sub">{{ section.settings.subheading }}</div>{%- endif -%}
</div>
{%- endif -%}

  <div class="ck-faq">
    {%- for block in section.blocks -%}
      <details class="ck-faq__item" {% if forloop.first and section.settings.open_first %}open{% endif %} {{ block.shopify_attributes }}>
        <summary class="ck-faq__q">{{ block.settings.question }}<span class="ck-faq__icon" aria-hidden="true"></span></summary>
        <div class="ck-text ck-faq__a">{{ block.settings.answer }}{%- if block.settings.show_proof -%}<span class="ck-proof">{{ settings.ck_proof_label }}{%- if block.settings.proof_note != blank %} {{ block.settings.proof_note }}{% endif -%}</span>{%- endif -%}</div>
      </details>
    {%- endfor -%}
  </div>
</div>
</div>
</div>

{% stylesheet %}
.ck-ec-faq { background: var(--ck-bg); color: var(--ck-fg); font-family: var(--ck-body-font); font-size: var(--ck-b-size-m); line-height: var(--ck-b-lh); padding-top: var(--ck-pad-top-m); padding-bottom: var(--ck-pad-bottom-m); text-align: var(--ck-align); }
.ck-ec-faq ck-scroller { display: block; }
.ck-ec-faq .ck-inner { max-width: var(--ck-max-width); margin: 0 auto; padding-left: var(--ck-gutter); padding-right: var(--ck-gutter); }
.ck-ec-faq[data-full-width] .ck-inner { max-width: 100%; }
.ck-ec-faq .ck-heading { font-family: var(--ck-heading-font); font-size: var(--ck-h-size-m); font-weight: var(--ck-h-weight); line-height: var(--ck-h-lh); letter-spacing: var(--ck-h-ls); text-transform: var(--ck-h-tt); color: var(--ck-heading-color); margin: 0; }
.ck-ec-faq .ck-text p { margin: 0; }
.ck-ec-faq .ck-btn { display: inline-block; background: var(--ck-btn-bg); color: var(--ck-btn-fg); border: var(--ck-btn-border-w) solid var(--ck-btn-border); border-radius: var(--ck-radius); padding: var(--ck-btn-py) var(--ck-btn-px); font-family: var(--ck-body-font); font-size: var(--ck-btn-size); font-weight: var(--ck-btn-weight); text-transform: var(--ck-btn-tt); letter-spacing: var(--ck-btn-ls); line-height: 1.2; text-decoration: none; cursor: pointer; transition: background-color var(--ck-anim-dur) ease; }
.ck-ec-faq .ck-btn:hover { background: var(--ck-btn-bg-hover); }
.ck-ec-faq[data-animate="fade"] .ck-inner { animation: ck-fade var(--ck-anim-dur) ease both; }
.ck-ec-faq[data-animate="slide"] .ck-inner { animation: ck-slide var(--ck-anim-dur) ease both; }
@keyframes ck-fade { from { opacity: 0; } to { opacity: 1; } }
@keyframes ck-slide { from { opacity: 0; transform: translateY(var(--ck-anim-distance)); } to { opacity: 1; transform: none; } }
@media screen and (max-width: 749px) { .ck-ec-faq[data-hide-mobile] { display: none; } }
@media screen and (min-width: 750px) {
  .ck-ec-faq { font-size: var(--ck-b-size); padding-top: var(--ck-pad-top); padding-bottom: var(--ck-pad-bottom); }
  .ck-ec-faq .ck-heading { font-size: var(--ck-h-size); }
  .ck-ec-faq[data-hide-desktop] { display: none; }
}
/* reduced motion must beat every animation rule above, including Dawn's */
@media (prefers-reduced-motion: reduce) { .ck-ec-faq * { animation: none !important; transition: none !important; } }

.ck-ec-faq .ck-head { margin-bottom: var(--ck-head-gap); }
.ck-ec-faq .ck-sub { margin-top: var(--ck-sub-gap); }

.ck-ec-faq .ck-proof { display: inline-block; margin: var(--ck-proof-gap, 6px) 0 0; padding: var(--ck-chip-py) var(--ck-chip-px); border: 1px dashed var(--ck-proof-fg); border-radius: var(--ck-radius); background: var(--ck-proof-bg); color: var(--ck-proof-fg); font-size: var(--ck-small); line-height: 1.6; }

.ck-ec-faq .ck-faq { max-width: var(--ck-faq-w); margin: 0 auto; display: grid; gap: var(--ck-gap); text-align: start; }
.ck-ec-faq .ck-faq__item { background: var(--ck-item-bg); border-radius: var(--ck-item-radius); }
.ck-ec-faq .ck-faq__q { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: var(--ck-row-pad); padding: var(--ck-row-pad); font-family: var(--ck-heading-font); font-size: var(--ck-q-size-m); font-weight: var(--ck-h-weight); color: var(--ck-heading-color); }
.ck-ec-faq .ck-faq__q::-webkit-details-marker { display: none; }
.ck-ec-faq .ck-faq__icon { position: relative; flex: 0 0 auto; width: var(--ck-small); height: var(--ck-small); }
.ck-ec-faq .ck-faq__icon::before, .ck-ec-faq .ck-faq__icon::after { content: ""; position: absolute; inset: 45% 0 auto; height: 2px; background: var(--ck-line); transition: transform var(--ck-anim-dur) ease; }
.ck-ec-faq .ck-faq__icon::after { transform: rotate(90deg); }
.ck-ec-faq .ck-faq__item[open] .ck-faq__icon::after { transform: rotate(0deg); }
.ck-ec-faq .ck-faq__a { padding: 0 var(--ck-row-pad) var(--ck-row-pad); }
@media screen and (min-width: 750px) { .ck-ec-faq .ck-faq__q { font-size: var(--ck-q-size); } }
{% endstylesheet %}

{% javascript %}
document.addEventListener('shopify:section:load', () => {});
document.addEventListener('shopify:section:unload', () => {});
{% endjavascript %}

