        "quotes_4": {
          "type": "quote",
          "settings": {
            "text": "«نفس الريحة بالضبط… بس ما يقعد.»"
          }
        }
      },
      "block_order": [
        "quotes_1",
        "quotes_2",
        "quotes_3",
        "quotes_4"
      ]
