    "quotes": {
      "type": "ck-ec-quotes",
      "settings": {
        "heading": "إذا قلت وحدة من هذي… مو بروحك.",
        "background_color": "#FFFFFF",
        "card_background": "#FFE3D7",
        "footer_text": "<p>المشكلة مو بجلدك. ومو لازم ترش أكثر. المشكلة بطريقة بناء العطر نفسه.</p>",
